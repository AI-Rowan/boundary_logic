# nine-feature biplots.
knitr::opts_template$set(
  biplot      = list(fig.width = 7,  fig.height = 7),
  biplot_wide = list(fig.width = 10, fig.height = 7)
)

# The SHAP comparison needs two optional packages; every SHAP chunk is
